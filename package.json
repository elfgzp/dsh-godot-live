{
  "name": "dsh-godot-live",
  "version": "0.1.0",
  "description": "Live Godot game view inside DeepSeek Harness: native rendering streamed as MJPEG into a DSH panel, plus input injection and agent tools. No Web export, no export templates.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "godot",
    "godot-engine",
    "game-development",
    "mjpeg",
    "live-preview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./runtime/*.gd": "./runtime/*.gd",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime/godot_live_stream.gd",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  }
}
